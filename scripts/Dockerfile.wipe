FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-wipe.txt /tmp/requirements-wipe.txt
RUN pip install --no-cache-dir -r /tmp/requirements-wipe.txt && rm /tmp/requirements-wipe.txt

WORKDIR /work

ENTRYPOINT ["python", "scripts/wipe_all_keep_tt_users.py"]
CMD ["--help"]
