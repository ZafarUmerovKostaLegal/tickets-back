# Copy to .env / Portainer stack env. Rotating passwords does NOT wipe Postgres volumes
# if you ALTER ROLE + update all service DSNs together (NEEDS_OPS — human).
#
# Generate secrets:
#   openssl rand -hex 32

JWT_SECRET=
WS_INTERNAL_SECRET=
OUTLOOK_TOKEN_FERNET_KEY=

# Redis (optional locally; required on prod)
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
# With password: REDIS_URL=redis://:YOUR_PASSWORD@redis:6379/0

# Per-DB passwords — replace compose defaults (gateway, tickets, chat, …)
USERS_DB_PASSWORD=
TICKETS_DB_PASSWORD=
CHAT_DB_PASSWORD=
TODOS_DB_PASSWORD=
TIME_TRACKING_DB_PASSWORD=
EXPENSES_DB_PASSWORD=
VACATION_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
CORRESPONDENCE_DB_PASSWORD=

# Gateway ops: set to false to disable GET /ops/databases
OPS_DATABASES_ENABLED=true

# Azure AD / mobile MSAL
# AUTH_REDIRECT_URI — web callback on gateway (keep for browser login):
#   https://YOUR_HOST/api/v1/auth/azure/callback
# AUTH_MOBILE_REDIRECT_URI — exact Android redirect from the app .env (do NOT use web callback):
#   msauth://com.kostalegal.tickets/QWv/YpjNHWz0oXRS6wMEogdvvn0=
AUTH_REDIRECT_URI=
AUTH_MOBILE_REDIRECT_URI=

# Retention dry-run (counts only — never deletes unless you later enable execute)
RETENTION_DRY_RUN=1
RETENTION_DAYS=365

# Time tracking: week Sat–Fri closes for edits on the following Monday at 12:00
WEEKLY_SUBMIT_TZ=Asia/Tashkent
WEEKLY_SUBMIT_DOW=1
WEEKLY_SUBMIT_HOUR=12
WEEKLY_SUBMIT_MINUTE=0
